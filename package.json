{
  "name": "ferrisearch",
  "version": "0.1.0",
  "description": "A blazing-fast search engine for Obsidian, powered by Tantivy",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:rust": "cd napi && npx napi build --release",
    "build:all": "npm run build:rust && npm run build"
  },
  "keywords": [],
  "author": "Josh",
  "license": "GPL-3",
  "devDependencies": {
    "@tsconfig/svelte": "^3.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.19",
    "esbuild-plugin-copy": "1.3.0",
    "esbuild-svelte": "^0.9.2",
    "obsidian": "1.7.2",
    "svelte": "^5.23.2",
    "svelte-check": "^4.1.5",
    "svelte-preprocess": "^6.0.3",
    "tslib": "2.3.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "cancelable-promise": "^4.3.1",
    "dexie": "^4.0.11",
    "lodash-es": "4.17.21",
    "search-query-parser": "^1.6.0"
  }
}
