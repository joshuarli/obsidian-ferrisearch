{
  "name": "ferrisearch",
  "version": "0.1.0",
  "description": "A blazing-fast search engine for Obsidian, powered by Tantivy",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run --watch build.ts",
    "build": "bun run build.ts production",
    "build:rust": "cd napi && bunx napi build --release",
    "build:all": "bun run build:rust && bun run build",
    "install-plugin": "bash scripts/build-and-install.sh",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [],
  "author": "Josh",
  "license": "GPL-3",
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.6.3",
    "@types/bun": "latest",
    "@types/lodash-es": "^4.17.12",
    "happy-dom": "^20.6.3",
    "obsidian": "1.7.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "lodash-es": "4.17.21",
    "search-query-parser": "^1.6.0"
  }
}
