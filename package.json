{
  "name": "ferrisearch",
  "version": "0.1.0",
  "description": "warp speed fuzzy text-only search",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run --watch build.ts",
    "build": "bun run build.ts production",
    "build:rust": "cd napi && bunx napi build --release",
    "build:all": "bun run build:rust && bun run build",
    "install-plugin": "bash scripts/build-and-install.sh",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx biome check .",
    "format": "bunx biome check --write ."
  },
  "keywords": [],
  "author": "joshuarli",
  "license": "GPL-3",
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@happy-dom/global-registrator": "^20.6.3",
    "@types/bun": "^1.3.9",
    "happy-dom": "^20.6.3",
    "knip": "^5.84.1",
    "obsidian": "1.12.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {}
}
